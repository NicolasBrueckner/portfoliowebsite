---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pagetitle="Home">
	<div class="video-container">
		<video autoplay loop muted playsinline>
			<source src="/WeepingWillow.webm" type="video/webm" />
			<source src="/WeepingWillow.mp4" type="video/mp4" />
		</video>
	</div>
</BaseLayout>

<style>
	.video-container {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.video-container video {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
