---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  visibleCount?: number;
}
const { images, visibleCount = 1 } = Astro.props;

const thumbnails = await Promise.all(
  images.map((img) => getImage({ src: img, format: "webp", width: 800 }))
);
const fullsize = await Promise.all(
  images.map((img) => getImage({ src: img, format: "webp" }))
);
---

<div
  class="carousel"
  data-visible={visibleCount}
  style={`--cols: ${thumbnails.length}; --visible: ${visibleCount}`}
>
  <div class="viewport">
    <div class="slides">
      {thumbnails.map((thumb, i) => (
        <a href={fullsize[i].src} class="glightbox" data-gallery="carousel">
          <img
            src={thumb.src}
            {...thumb.attributes}
            alt={`Project image ${i + 1}`}
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
    <button class="prev" aria-label="Previous slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="30.08 24.98 128.78 300.03" width="70%" height="70%">
        <path fill="currentColor" d="M301.179 521.701c-3.015 7.225-3.015 14.45 0 21.675l63.232 128.311c-2.409 6.03-7.529 9.946-15.36 11.748a13789.754 13789.754 0 0 0-52.395-68.223c-17.464-22.594-35.84-45.335-55.124-68.224-7.832-9.633-7.832-18.972 0-28.017 19.285-22.888 37.66-45.477 55.124-67.768a6689.84 6689.84 0 0 0 52.395-67.768c7.831 1.214 12.951 5.13 15.36 11.747l-63.232 126.52z" transform="translate(-205.555 -358.435)"/>
      </svg>
    </button>
    <button class="next" aria-label="Next slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="30.08 24.98 128.82 300.03" width="70%" height="70%">
        <path fill="currentColor" d="M298.918 521.701c3.015 7.225 3.015 14.45 0 21.675l-63.26 128.311c2.409 6.03 7.529 9.946 15.36 11.748a15032.33 15032.33 0 0 1 52.422-68.223c17.465-22.594 35.84-45.335 55.125-68.224 7.832-9.633 7.832-18.972 0-28.017-19.285-22.888-37.66-45.477-55.125-67.768a6971.29 6971.29 0 0 1-52.422-67.768c-7.831 1.214-12.951 5.13-15.36 11.747l63.26 126.52z" transform="translate(-205.555 -358.435)"/>
      </svg>
    </button>
  </div>
  <div class="dots"></div>
</div>

<style is:global>
  @import "glightbox/dist/css/glightbox.css";
</style>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.75rem;
  }

  .viewport {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .slides {
    --gap: 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: repeat(
      var(--cols, 1),
      calc((100% - (var(--visible, 1) - 1) * var(--gap)) / var(--visible, 1))
    );
    gap: var(--gap);
    align-items: center;
    width: 100%;
    transition: transform 0.4s ease;
  }

  .slides a {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .slides a:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    transform: translateY(-2px);
  }

  .slides img {
    width: 100%;
    height: auto;
    display: block;
  }

  button.prev,
  button.next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--primary-transparent);
    border: none;
    width: 2.4em;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--text);
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
    transition: background 0.2s ease, transform 0.15s ease;
  }

  button.prev { left: 0.5rem; }
  button.next { right: 0.5rem; }

  button.prev:hover,
  button.next:hover {
    background: var(--secondary-transparent);
  }

  button.prev:focus-visible,
  button.next:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  button.prev:active,
  button.next:active {
    transform: translateY(-50%) scale(0.93);
  }

  .dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .dots :global(button) {
    appearance: none;
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--secondary);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .dots :global(button:hover) {
    background: var(--secondary-hover);
  }

  .dots :global(button.active) {
    background: var(--accent);
    transform: scale(1.3);
  }

  .dots :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  import GLightbox from "glightbox";

  GLightbox({ touchNavigation: true, loop: true, selector: ".glightbox" });

  document.querySelectorAll<HTMLElement>(".carousel[data-visible]").forEach((carousel) => {
    const slides = carousel.querySelector<HTMLElement>(".slides")!;
    const slideEls = Array.from(carousel.querySelectorAll<HTMLElement>(".slides > a"));
    const dotsContainer = carousel.querySelector<HTMLElement>(".dots")!;
    const desiredVisible = parseInt(carousel.dataset.visible ?? "1");
    const total = slideEls.length;
    let visible = desiredVisible;
    let maxIndex = Math.max(total - visible, 0);
    let current = 0;

    function computeVisible() {
      const width = window.innerWidth;
      if (width <= 640) return 1;
      if (width <= 1024) return Math.min(2, desiredVisible);
      return desiredVisible;
    }

    function renderDots() {
      dotsContainer.innerHTML = "";
      if (maxIndex <= 0) return;
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
        dot.addEventListener("click", () => {
          current = i;
          update();
        });
        dotsContainer.appendChild(dot);
      }
    }

    function updateDots() {
      Array.from(dotsContainer.children).forEach((dot, i) => {
        dot.classList.toggle("active", i === current);
      });
    }

    function update() {
      const step = (slideEls[0]?.getBoundingClientRect().width ?? 0) + 16;
      slides.style.transform = `translateX(-${current * step}px)`;
      updateDots();
    }

    function relayout() {
      visible = computeVisible();
      carousel.style.setProperty("--visible", String(visible));
      maxIndex = Math.max(total - visible, 0);
      current = Math.min(current, maxIndex);
      renderDots();
      update();
    }

    carousel.querySelector(".next")?.addEventListener("click", () => {
      current = current + 1 > maxIndex ? 0 : current + 1;
      update();
    });

    carousel.querySelector(".prev")?.addEventListener("click", () => {
      current = current - 1 < 0 ? maxIndex : current - 1;
      update();
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(relayout, 150);
    });

    relayout();
  });
</script>
