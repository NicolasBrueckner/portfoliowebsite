---
import ContentLayout from "./ContentLayout.astro";
import Carousel from "../components/Carousel.astro";
import Separator from "../components/Separator.astro";

import type { ImageMetadata } from "astro";

const { frontmatter } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/project_images/**/*.{png,jpg,jpeg,webp,gif}",
  { eager: true }
);

const images: ImageMetadata[] = Object.entries(allImages)
  .filter(([p]) => p.includes(`/${frontmatter.folderName}/`) && !/\/cover\.[^/]+$/i.test(p))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<ContentLayout pagetitle=`Projects/${frontmatter.title}`>
  <div
    class="hero-container"
    style={`background: linear-gradient(${frontmatter.colorFrom}, ${frontmatter.colorTo})`}
  >
    <h1>{frontmatter.title}</h1>
    <h2>{frontmatter.tagline}</h2>
  </div>
  <div class="carousel-container">
    <Carousel images={images} visibleCount={3} />
  </div>
  <Separator thickness={3} margin="50px" length="75%" color="var(--accent)" />
  <div class="description-container">
    <slot />
  </div>
  <div>
    <a
      href={frontmatter.link}
      class="link-container"
      target="_blank"
      rel="noopener noreferrer"
    >
      {frontmatter.linkText}
    </a>
  </div>
</ContentLayout>

<style>
  .hero-container {
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 1em 3em;
    width: 100%;
    min-height: 15em;
    margin: 10px;
    margin-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .carousel-container {
    display: flex;
    width: 90%;
    margin: 10px;
    padding: 0.5rem;
    border-radius: 5px;
    align-items: center;
    justify-content: center;
    background-color: var(--primary);
  }

  .description-container {
    background-color: var(--primary);
    width: 90%;
    margin: 10px;
    padding: 0.5rem;
    border-radius: 5px;
    text-align: justify;
    font-size: 1.3rem;
  }

  .link-container {
    text-decoration: none;
  }
</style>

<style>
  .description-container :global(p) {
    margin-top: 1em;
    margin-bottom: 1em;
  }
</style>
